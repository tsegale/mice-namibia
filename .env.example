# Copy to .env and fill in. Never commit .env.
# The app refuses to start if a required value is missing or invalid.

NODE_ENV=development          # development | production | test
SITE_ENV=local                # local | staging | production (anything but production sends noindex)
PORT=3000
BASE_URL=http://localhost:3000

# MySQL / MariaDB (cPanel: create the database and user under "MySQL Databases")
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mice
DB_USER=mice
DB_PASSWORD=

# At least 32 random characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true behind a proxy. Always true on cPanel/Passenger (npm run doctor
# fails in production without it): TLS ends before Node, and secure cookies
# and client IPs depend on it.
TRUST_PROXY=false

# Where uploaded images are stored. Keep it outside anything a deploy overwrites
# (on the server: an absolute path outside the app root, see DEPLOY.md).
UPLOADS_DIR=storage/uploads
UPLOAD_MAX_MB=12

# Where scripts/backup.sh writes the daily database dump and uploads archive
# (14 days kept). Relative paths start at the app root; the default sits
# beside it, never inside.
BACKUP_DIR=../backups

# Email for enquiry notifications (corporate.events@zusammentravels.com mailbox).
# Leave SMTP_HOST empty to store enquiries without sending email.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Optional: lock the whole staging site behind a browser password, "user:password".
STAGING_BASIC_AUTH=

LOG_LEVEL=info
