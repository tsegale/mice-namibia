# Copy to .env and fill in. Never commit .env.
# The app refuses to start if a required value is missing or invalid.

NODE_ENV=development          # development | production | test
SITE_ENV=local                # local | staging | production (anything but production sends noindex)
PORT=3000
BASE_URL=http://localhost:3000

# MySQL / MariaDB (cPanel: create the database and user under "MySQL Databases")
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mice
DB_USER=mice
DB_PASSWORD=

# At least 32 random characters, e.g. the output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to true when running behind a proxy (cPanel/Passenger in production does this automatically).
TRUST_PROXY=false

# Where uploaded images are stored. Keep it outside anything a deploy overwrites.
UPLOADS_DIR=storage/uploads
UPLOAD_MAX_MB=12

# Email for enquiry notifications (corporate.events@zusammentravels.com mailbox).
# Leave SMTP_HOST empty to store enquiries without sending email.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# Optional: lock the whole staging site behind a browser password, "user:password".
STAGING_BASIC_AUTH=

LOG_LEVEL=info
