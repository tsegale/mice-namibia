  <footer class="site-footer">
    <div class="container footer-main">
      <div class="footer-brand">
        <a href="/" class="brand-lockup brand-lockup--light">
          <img src="/assets/images/zusammen-logo.png" alt="Zusammen Tours and Travel Agency, home" width="41" height="44" loading="lazy">
          <span class="brand-lockup-tagline" aria-hidden="true"><span>Meetings, Incentives</span><span>Conferences, Exhibitions</span></span>
        </a>
        <p><%= site.companyLine %></p>
        <div class="footer-contact">
          <a href="<%= site.tel %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg><%= site.contact.phone %></a>
          <a href="mailto:<%= site.contact.email %>"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 6l10 7 10-7"/></svg><%= site.contact.email %></a>
        </div>
        <div class="footer-social">
          <%- C.site.socialLinks(site.social) %>
        </div>
      </div>

      <nav class="footer-col" aria-labelledby="footer-explore">
        <h2 id="footer-explore">Explore</h2>
        <ul>
          <li><a href="/about">About Us</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/venues">Venues</a></li>
          <li><a href="/events">Events</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-labelledby="footer-resources">
        <h2 id="footer-resources">Resources</h2>
        <ul>
          <li><a href="/team">Meet the Team</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/partners">Our Partners</a></li>
          <li><a href="/pricing">Pricing</a></li>
        </ul>
      </nav>

      <nav class="footer-col" aria-labelledby="footer-legal">
        <h2 id="footer-legal">Legal</h2>
        <ul>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions">Terms and Conditions</a></li>
        </ul>
      </nav>
    </div>

    <div class="container footer-flags">
      <p class="footer-flags-label"><%= locals.siteCounts ? numberWord(siteCounts.destinations, { capital: true }) + ' destinations' : 'Our destinations' %></p>
      <ul>
        <%- locals.siteCounts ? C.destinations.footerFlags(siteCounts.destinationList) : '' %>
      </ul>
    </div>

    <div class="footer-bottom">
      <div class="container">
        <p>Copyright <span data-current-year>2026</span> <%= site.footer.copyright_holder %>. All rights reserved.</p>
      </div>
    </div>
  </footer>

  <button type="button" class="back-to-top" data-back-to-top aria-label="Back to top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="6 15 12 9 18 15"/></svg></button>

  <script src="/js/main.js?v=<%= assetVersion %>" nonce="<%= cspNonce %>"></script>
</body>
</html>
