<%# name, label, value, type='text', required, hint, maxlength, placeholder, attrs, count, warn (counter turns orange past it) %>
<% const fid = 'f-' + name; %>
<div class="form-group">
  <label for="<%= fid %>"><%= label %><% if (locals.required) { %> <span class="required" aria-hidden="true">*</span><% } %><% if (locals.count) { %><span class="char-count" aria-hidden="true"></span><% } %></label>
  <input type="<%= locals.type || 'text' %>" id="<%= fid %>" name="<%= name %>" value="<%= locals.value == null ? '' : value %>"<% if (locals.required) { %> required<% } %><% if (locals.maxlength) { %> maxlength="<%= maxlength %>"<% } %><% if (locals.count) { %> data-count="<%= maxlength %>"<% } %><% if (locals.warn) { %> data-warn="<%= warn %>"<% } %><% if (locals.placeholder) { %> placeholder="<%= placeholder %>"<% } %><% if (locals.hint) { %> aria-describedby="<%= fid %>-hint"<% } %><%- locals.attrs || '' %>>
  <% if (locals.hint) { %><p class="form-hint" id="<%= fid %>-hint"><%= hint %></p><% } %>
</div>
