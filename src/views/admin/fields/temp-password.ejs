<%# value, who (name of the person, or null for a new account) %>
<div class="form-group">
  <label for="f-temporary_password">Temporary password</label>
  <div class="copy-field">
    <input type="text" id="f-temporary_password" name="temporary_password" value="<%= value %>" readonly autocomplete="off" spellcheck="false" aria-describedby="f-temporary_password-hint">
    <button type="button" class="btn btn-ghost" data-copy="#f-temporary_password"><svg class="icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-copy"/></svg><span data-copy-label>Copy</span></button>
  </div>
  <p class="form-hint" id="f-temporary_password-hint">Copy it now and give it to <%= locals.who || 'them' %> by phone or a separate message, not in the same email as the login address. It is not shown again after you save. They must choose their own password the first time they log in.</p>
</div>
