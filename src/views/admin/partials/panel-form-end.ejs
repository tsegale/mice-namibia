<%# deleteUrl, deleteLabel, deleteWarning, viewUrl, saveLabel %>
  </div>
  <div class="panel-footer">
    <div class="inline">
      <% if (locals.deleteUrl) { %><button type="button" class="btn btn-ghost btn-icon-danger" data-delete="<%= deleteUrl %>" data-label="<%= deleteLabel %>"<% if (locals.deleteWarning) { %> data-warning="<%= deleteWarning %>"<% } %>><svg class="icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-trash"/></svg>Delete</button><% } %>
      <% if (locals.viewUrl) { %><a class="btn btn-ghost" href="<%= viewUrl %>" target="_blank" rel="noopener"><svg class="icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-external"/></svg>View on site</a><% } %>
    </div>
    <div class="panel-footer-right">
      <button type="button" class="btn btn-ghost" data-close-panel>Cancel</button>
      <button type="submit" class="btn btn-primary"><svg class="icon-sm" aria-hidden="true"><use href="/admin/icons.svg#i-check"/></svg><%= locals.saveLabel || 'Save' %></button>
    </div>
  </div>
</form>
