<% const editing = Boolean(f.id); %>
<%- include('../partials/panel-form-start', { action: editing ? `/admin/faqs/${f.id}` : '/admin/faqs', method: editing ? 'PUT' : 'POST', title: editing ? 'Edit question' : 'Add a question' }) %>
    <div class="panel-section">
      <div class="panel-section-label">Question</div>
      <%- include('../fields/input', { name: 'question', label: 'Question', value: f.question, required: true, maxlength: 255, attrs: ' autofocus' }) %>
      <%- include('../fields/rte', { name: 'answer', label: 'Answer', value: f.answer, required: true, basic: true, hint: 'Keep it short. Paragraphs, bold, italic, lists and links are kept; other formatting is removed when you save.' }) %>
      <div class="form-row cols-2">
        <%- include('../fields/select', { name: 'group_id', label: 'Group', value: f.group_id, required: true, empty: 'Choose a group', options: groups.map((g) => ({ value: g.id, label: g.name })) }) %>
        <%- include('../fields/select', { name: 'country_iso2', label: 'Country flag', value: f.country_iso2, empty: 'No flag', options: countries.map((c) => ({ value: c.iso2, label: c.name })), hint: 'For questions about one destination.' }) %>
      </div>
    </div>
    <div class="panel-section">
      <div class="panel-section-label">Publishing</div>
      <%- include('../fields/checkbox', { name: 'show_on_home', label: 'Show on the homepage', checked: f.show_on_home, hint: `The homepage shows at most ${homeLimit} questions: the first ${homeLimit} published ones marked here, in list order.` }) %>
      <%- include('../fields/status', { value: f.status }) %>
    </div>
<%- include('../partials/panel-form-end', { deleteUrl: editing ? `/admin/faqs/${f.id}` : null, deleteLabel: 'this question', viewUrl: editing && f.status === 'published' ? '/faq' : null }) %>
