<% const editing = Boolean(t.id); %>
<%- include('../partials/panel-form-start', { action: editing ? `/admin/pricing/${t.id}` : '/admin/pricing', method: editing ? 'PUT' : 'POST', title: editing ? `Edit ${t.name}` : 'Add a ticket tier' }) %>
    <div class="panel-section">
      <div class="panel-section-label">Tier</div>
      <%- include('../fields/input', { name: 'name', label: 'Name', value: t.name, required: true, maxlength: 80, attrs: ' autofocus', placeholder: 'Early Bird', hint: 'Also what the Request Pricing button puts in the contact form.' }) %>
      <%- include('../fields/input', { name: 'tagline', label: 'Tagline', value: t.tagline, maxlength: 255, count: true, hint: 'One sentence under the price.' }) %>
      <%- include('../fields/textarea', { name: 'features', label: 'Features', value: t.features.join('\n'), rows: 6, hint: 'One per line, in the order shown (at most 12).' }) %>
    </div>
    <div class="panel-section">
      <div class="panel-section-label">Publishing</div>
      <%- include('../fields/checkbox', { name: 'highlighted', label: 'Most popular', checked: t.highlighted, hint: 'Shown as the navy card with the "Most popular" badge. Only one tier can have it; ticking it here takes it off the others.' }) %>
      <%- include('../fields/status', { value: t.status }) %>
    </div>
<%- include('../partials/panel-form-end', { deleteUrl: editing ? `/admin/pricing/${t.id}` : null, deleteLabel: `the tier "${t.name}"`, viewUrl: editing && t.status === 'published' ? '/pricing' : null }) %>
