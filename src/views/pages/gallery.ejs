<%- include('../partials/top') %>

<section class="page-header">
  <picture class="page-header-media">
    <source type="image/webp" srcset="/assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-640.webp 640w, /assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-1280.webp 1280w, /assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-1920.webp 1920w" sizes="100vw">
    <img src="/assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-1280.jpg" srcset="/assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-640.jpg 640w, /assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-1280.jpg 1280w, /assets/images/gallery/corporate-meetings-and-events-in-africa-namibia-1920.jpg 1920w" sizes="100vw" alt="" width="1920" height="1280" fetchpriority="high">
  </picture>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">Gallery</li></ol></nav>
    <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">01</span>&nbsp;/ Gallery</p>
    <h1>Gallery</h1>
    <p class="page-subtitle">Venues, events and experiences from across our <%= numberWord(siteCounts.destinations) %> African destinations.</p>
  </div>
</section>

<section class="section" aria-labelledby="gallery-intro-title">
  <div class="container">
    <div class="gallery-head">
      <div>
        <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">02</span>&nbsp;/ Moments</p>
        <h2 id="gallery-intro-title">Moments from our venues and <em class="accent">events</em></h2>
      </div>
      <p>Conference halls, boardrooms, gala dinners and the destinations around them. Select a photo to view it full size.</p>
    </div>
    <div class="chip-filters gallery-filters" role="group" aria-label="Filter photos" data-gallery-filter>
      <%- C.gallery.chips(galleryItems, galleryCategories) %>
    </div>
    <p class="visually-hidden" aria-live="polite" data-gallery-status></p>
    <div class="gallery-grid" data-lightbox data-gallery-grid>
      <%- C.gallery.grid(galleryItems) %>
    </div>
  </div>
</section>

<%- include('../partials/bottom') %>
