<%- include('../partials/top') %>

<section class="page-header">
  <picture class="page-header-media">
    <source type="image/webp" srcset="/assets/images/venues/windhoek-country-club-resort-casino/gardens-640.webp 640w, /assets/images/venues/windhoek-country-club-resort-casino/gardens-1280.webp 1280w, /assets/images/venues/windhoek-country-club-resort-casino/gardens-1920.webp 1920w" sizes="100vw">
    <img src="/assets/images/venues/windhoek-country-club-resort-casino/gardens-1280.jpg" srcset="/assets/images/venues/windhoek-country-club-resort-casino/gardens-640.jpg 640w, /assets/images/venues/windhoek-country-club-resort-casino/gardens-1280.jpg 1280w, /assets/images/venues/windhoek-country-club-resort-casino/gardens-1920.jpg 1920w" sizes="100vw" alt="" width="1920" height="1281" fetchpriority="high">
  </picture>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">About Us</li></ol></nav>
    <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">01</span>&nbsp;/ About Us</p>
    <h1>About Us</h1>
    <p class="page-subtitle">The MICE department of Zusammen Tours and Travel Agency, planning meetings, incentives, conferences and exhibitions across <%= numberWord(siteCounts.destinations) %> African destinations.</p>
  </div>
</section>

<div class="hero-stats-wrap">
  <div class="container">
    <dl class="hero-stats" data-reveal>
      <div class="hero-stat"><dt>African destinations</dt><dd><span data-count-to="<%= siteCounts.destinations %>"><%= siteCounts.destinations %></span></dd></div>
      <div class="hero-stat"><dt>Partner venues and hotels</dt><dd><span data-count-to="<%= siteCounts.partners %>"><%= siteCounts.partners %></span></dd></div>
      <div class="hero-stat"><dt>Event services</dt><dd><span data-count-to="10">10</span></dd></div>
      <div class="hero-stat"><dt>Upcoming conferences</dt><dd><span data-count-to="<%= upcoming.length %>" data-conference-count><%= upcoming.length %></span></dd></div>
    </dl>
  </div>
</div>

<section class="section home-about" aria-labelledby="about-title">
  <div class="container home-about-grid">
    <div class="about-collage" data-reveal>
      <picture class="about-collage-main">
        <source type="image/webp" srcset="/assets/images/venues/windhoek-country-club-resort-casino/conference-centre-640.webp 640w, /assets/images/venues/windhoek-country-club-resort-casino/conference-centre-1280.webp 1280w, /assets/images/venues/windhoek-country-club-resort-casino/conference-centre-1920.webp 1920w" sizes="(max-width: 900px) 70vw, 380px">
        <img src="/assets/images/venues/windhoek-country-club-resort-casino/conference-centre-1280.jpg" srcset="/assets/images/venues/windhoek-country-club-resort-casino/conference-centre-640.jpg 640w, /assets/images/venues/windhoek-country-club-resort-casino/conference-centre-1280.jpg 1280w, /assets/images/venues/windhoek-country-club-resort-casino/conference-centre-1920.jpg 1920w" sizes="(max-width: 900px) 70vw, 380px" alt="Conference centre at Windhoek Country Club Resort & Casino" width="1920" height="1281" loading="lazy" decoding="async">
      </picture>
      <picture class="about-collage-top">
        <source type="image/webp" srcset="/assets/images/venues/the-westin-cape-town/conference-venue-2-640.webp 640w, /assets/images/venues/the-westin-cape-town/conference-venue-2-1280.webp 1280w" sizes="(max-width: 900px) 50vw, 260px">
        <img src="/assets/images/venues/the-westin-cape-town/conference-venue-2-1280.jpg" srcset="/assets/images/venues/the-westin-cape-town/conference-venue-2-640.jpg 640w, /assets/images/venues/the-westin-cape-town/conference-venue-2-1280.jpg 1280w" sizes="(max-width: 900px) 50vw, 260px" alt="Conference venue at The Westin Cape Town" width="1280" height="720" loading="lazy" decoding="async">
      </picture>
      <picture class="about-collage-bottom">
        <source type="image/webp" srcset="/assets/images/venues/wicc/event-3-640.webp 640w, /assets/images/venues/wicc/event-3-1280.webp 1280w, /assets/images/venues/wicc/event-3-1920.webp 1920w" sizes="(max-width: 900px) 50vw, 260px">
        <img src="/assets/images/venues/wicc/event-3-1280.jpg" srcset="/assets/images/venues/wicc/event-3-640.jpg 640w, /assets/images/venues/wicc/event-3-1280.jpg 1280w, /assets/images/venues/wicc/event-3-1920.jpg 1920w" sizes="(max-width: 900px) 50vw, 260px" alt="Outdoor stage with a media partners screen at WICC" width="1920" height="1280" loading="lazy" decoding="async">
      </picture>
      <p class="about-badge"><span class="about-badge-num" data-count-to="<%= siteCounts.destinations %>"><%= siteCounts.destinations %></span><span>African Destinations Served</span></p>
    </div>
    <div class="home-about-text">
      <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">02</span>&nbsp;/ Who we are</p>
      <h2 id="about-title">Zusammen Travels: Connecting the World Through a Global Digital Experience</h2>
      <p>Zusammen Travels brings the world closer through a global digital experience that inspires exploration, connection, and discovery. Through innovation and meaningful travel experiences, we connect people with destinations, cultures, and opportunities worldwide, creating a connected space where stories, experiences, and global possibilities come together.</p>
      <div class="home-about-actions">
        <a href="/contact?type=proposal#contact-form" class="btn btn-primary">Request a Proposal</a>
        <a href="/services" class="text-link">Explore our services <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="13 6 19 12 13 18"/></svg></a>
      </div>
    </div>
  </div>
</section>

<section class="section home-destinations" aria-labelledby="destinations-title">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">03</span>&nbsp;/ Destinations</p>
      <h2 id="destinations-title">One Partner. <%= numberWord(siteCounts.destinations, { capital: true }) %> Destinations. Unlimited MICE Possibilities.</h2>
      <p>From Meetings, Incentives, Conferences, and Exhibitions (MICE) to corporate gatherings and destination experiences, we provide end-to-end event management across <%- C.destinations.nameList(siteCounts.destinationList) %>. With regional expertise and trusted partnerships, we help organisations create impactful and memorable business events throughout Africa.</p>
    </div>
    <ul class="dest-mosaic" data-reveal-stagger="60">
      <%- C.destinations.mosaic(siteCounts.destinationList) %>
    </ul>
  </div>
</section>

