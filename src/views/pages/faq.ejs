<%- include('../partials/top') %>

<section class="page-header">
  <picture class="page-header-media">
    <source type="image/webp" srcset="/assets/images/gallery/conference-and-meeting-planning-services-africa-namibia-640.webp 640w, /assets/images/gallery/conference-and-meeting-planning-services-africa-namibia-1280.webp 1280w" sizes="100vw">
    <img src="/assets/images/gallery/conference-and-meeting-planning-services-africa-namibia-1280.jpg" srcset="/assets/images/gallery/conference-and-meeting-planning-services-africa-namibia-640.jpg 640w, /assets/images/gallery/conference-and-meeting-planning-services-africa-namibia-1280.jpg 1280w" sizes="100vw" alt="" width="1920" height="1280" fetchpriority="high">
  </picture>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><ol><li><a href="/">Home</a></li><li aria-current="page">FAQ</li></ol></nav>
    <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">01</span>&nbsp;/ FAQ</p>
    <h1>FAQ</h1>
  </div>
</section>

<section class="section" aria-labelledby="faq-title">
  <div class="container faq-layout">
    <aside class="faq-aside">
      <div class="faq-aside-inner">
        <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">02</span>&nbsp;/ Questions and answers</p>
        <h2 id="faq-title">MICE Frequently Asked Questions: Africa</h2>
        <p>Answers to the questions we hear most often from organisations planning meetings, incentives, conferences and exhibitions across Africa.</p>
        <nav aria-label="FAQ topics">
          <ul class="faq-jumps">
          <%- C.faqs.jumps(faqGroups) %>
          </ul>
        </nav>
        <div class="faq-aside-card">
        <picture>
          <source type="image/webp" srcset="/assets/images/venues/wicc/gallery-01-640.webp 640w, /assets/images/venues/wicc/gallery-01-1280.webp 1280w, /assets/images/venues/wicc/gallery-01-1920.webp 1920w" sizes="(max-width: 1080px) 100vw, 420px">
          <img src="/assets/images/venues/wicc/gallery-01-1280.jpg" srcset="/assets/images/venues/wicc/gallery-01-640.jpg 640w, /assets/images/venues/wicc/gallery-01-1280.jpg 1280w, /assets/images/venues/wicc/gallery-01-1920.jpg 1920w" sizes="(max-width: 1080px) 100vw, 420px" alt="Keynote address on the main stage at a Windhoek International Convention Centre conference" width="1280" height="853" loading="lazy" decoding="async">
        </picture>
          <div class="faq-aside-card-body">
            <p class="faq-aside-card-title">Still have a question?</p>
            <p>Tell us about your group and dates and we will come back with answers and options.</p>
            <a href="/contact#contact-form" class="btn btn-primary">Contact Us</a>
          </div>
        </div>
      </div>
    </aside>
    <div class="faq-main">
      <div class="faq-search">
        <label for="faq-search-input" class="visually-hidden">Search the FAQ</label>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="faq-search-input" placeholder="Search questions, for example Victoria Falls" autocomplete="off" data-faq-search>
      </div>
      <p class="faq-search-status" aria-live="polite" data-faq-status></p>
      <%- faqGroups.map(C.faqs.group).join("\n") %>
      <div class="faq-empty" hidden data-faq-empty>
        <p>No questions match your search.</p>
        <button type="button" class="btn btn-outline" data-faq-reset>Show all questions</button>
      </div>
    </div>
  </div>
</section>

