      </figure>
      <figure class="hero-slide" data-hero-slide role="group" aria-roledescription="slide" aria-label="2 of 5: Evening reception, Windhoek International Convention Centre, Namibia" aria-hidden="true">
        <picture>
          <source type="image/webp" srcset="/assets/images/hero/hero-02-wicc-evening-reception-640.webp 640w, /assets/images/hero/hero-02-wicc-evening-reception-1280.webp 1280w, /assets/images/hero/hero-02-wicc-evening-reception-1920.webp 1920w" sizes="100vw">
