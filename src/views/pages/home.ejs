        <figcaption class="hero-caption"><img src="/assets/images/flags/na.svg" alt="" width="24" height="18">Evening reception, Windhoek International Convention Centre, Namibia</figcaption>
      </figure>
      <figure class="hero-slide" data-hero-slide role="group" aria-roledescription="slide" aria-label="3 of 5: The Westin Cape Town, South Africa" aria-hidden="true">
