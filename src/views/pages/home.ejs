  <div class="container hero-content">
    <p class="eyebrow eyebrow--light"><span class="stripe" aria-hidden="true"></span>Zusammen Travels MICE</p>
    <h1>Elevating Meetings, Incentives, Conferences &amp; <em class="accent">Exhibitions</em></h1>
    <p class="hero-lead">Delivering exceptional event solutions that inspire audiences, strengthen relationships, and create measurable business impact.</p>
    <div class="hero-actions">
      <a href="/contact?type=proposal#contact-form" class="btn btn-primary">Request a Proposal</a>
      <a href="/services" class="btn btn-ghost btn-ghost--light">Explore Services</a>
    </div>
  </div>
  <div class="container hero-controls">
    <div class="hero-dots" role="group" aria-label="Choose a slide">
      <button type="button" class="hero-dot" data-hero-dot="0" aria-label="Show slide 1: Windhoek International Convention Centre, Namibia" aria-current="true"></button>
      <button type="button" class="hero-dot" data-hero-dot="1" aria-label="Show slide 2: Evening reception, Windhoek International Convention Centre, Namibia"></button>
      <button type="button" class="hero-dot" data-hero-dot="2" aria-label="Show slide 3: The Westin Cape Town, South Africa"></button>
      <button type="button" class="hero-dot" data-hero-dot="3" aria-label="Show slide 4: Windhoek Country Club Resort, Namibia"></button>
      <button type="button" class="hero-dot" data-hero-dot="4" aria-label="Show slide 5: Movenpick Windhoek, Namibia"></button>
    </div>
    <button type="button" class="hero-pause" data-hero-pause aria-label="Pause slideshow"><svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg><svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10-6.5a1 1 0 0 0 0-1.72l-10-6.5A1 1 0 0 0 8 5.5z"/></svg></button>
  </div>
</section>

<div class="hero-stats-wrap">
  <div class="container">
    <dl class="hero-stats" data-reveal>
      <div class="hero-stat"><dt>African destinations</dt><dd><span data-count-to="<%= siteCounts.destinations %>"><%= siteCounts.destinations %></span></dd></div>
      <div class="hero-stat"><dt>Partner venues and hotels</dt><dd><span data-count-to="<%= siteCounts.partners %>"><%= siteCounts.partners %></span></dd></div>
      <div class="hero-stat"><dt>Event services</dt><dd><span data-count-to="10">10</span></dd></div>
      <div class="hero-stat"><dt>Upcoming conferences</dt><dd><span data-count-to="<%= upcoming.length %>" data-conference-count><%= upcoming.length %></span></dd></div>
    </dl>
  </div>
</div>

<section class="section home-destinations" aria-labelledby="destinations-title">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow"><span class="stripe" aria-hidden="true"></span><span class="eyebrow-num">01</span>&nbsp;/ Destinations</p>
      <h2 id="destinations-title">One Partner. <%= numberWord(siteCounts.destinations, { capital: true }) %> Destinations. Unlimited MICE Possibilities.</h2>
      <p>From Meetings, Incentives, Conferences, and Exhibitions (MICE) to corporate gatherings and destination experiences, we provide end-to-end event management across <%- C.destinations.nameList(siteCounts.destinationList) %>. With regional expertise and trusted partnerships, we help organisations create impactful and memorable business events throughout Africa.</p>
    </div>
    <ul class="dest-mosaic" data-reveal-stagger="60">
      <%- C.destinations.mosaic(siteCounts.destinationList) %>
    </ul>
  </div>
</section>

